diff --git a/cmd/config/init_ksfassistant_test.go b/cmd/config/init_ksfassistant_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/config/init_ksfassistant_test.go
@@ -0,0 +1,22 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/larksuite/cli/internal/core"
+)
+
+func TestConfigInitJSONRegistrationUserIsOptional(t *testing.T) {
+	without := configInitJSON(&configInitResult{AppID: "cli_fixture", AppSecret: "private", Brand: core.BrandFeishu})
+	if without["appSecret"] != "****" || without["registrationUser"] != nil {
+		t.Fatalf("unexpected result without registration user: %#v", without)
+	}
+	with := configInitJSON(&configInitResult{
+		AppID: "cli_fixture", AppSecret: "private", Brand: core.BrandFeishu,
+		RegistrationUser: &registrationUser{OpenID: "ou_fixture", TenantBrand: "feishu"},
+	})
+	user, ok := with["registrationUser"].(*registrationUser)
+	if !ok || user.OpenID != "ou_fixture" || user.TenantBrand != "feishu" || with["appSecret"] != "****" {
+		t.Fatalf("registration user was not returned safely: %#v", with)
+	}
+}
diff --git a/cmd/auth/logout_ksfassistant_test.go b/cmd/auth/logout_ksfassistant_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/auth/logout_ksfassistant_test.go
@@ -0,0 +1,45 @@
+package auth
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"testing"
+
+	"github.com/larksuite/cli/internal/cmdutil"
+	"github.com/larksuite/cli/internal/core"
+)
+
+func TestAuthLogoutRunPurgeLocalProfileRemovesIsolatedConfig(t *testing.T) {
+	t.Setenv("LARKSUITE_CLI_CONFIG_DIR", t.TempDir())
+	writeLogoutConfig(t, nil)
+	f, stdout, _, _ := cmdutil.TestFactory(t, nil)
+	if err := authLogoutRun(&LogoutOptions{Factory: f, JSON: true, PurgeLocalProfile: true}); err != nil {
+		t.Fatal(err)
+	}
+	var result map[string]interface{}
+	if json.Unmarshal(stdout.Bytes(), &result) != nil || result["purged"] != true {
+		t.Fatalf("purge result invalid: %s", stdout.String())
+	}
+	if _, err := os.Stat(core.GetConfigPath()); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("isolated config survived purge: %v", err)
+	}
+}
+
+func TestAuthLogoutRunPurgeLocalProfileRejectsSharedConfig(t *testing.T) {
+	t.Setenv("LARKSUITE_CLI_CONFIG_DIR", t.TempDir())
+	config := &core.MultiAppConfig{CurrentApp: "default", Apps: []core.AppConfig{
+		{Name: "default", AppId: "cli_first", AppSecret: core.PlainSecret("first"), Brand: core.BrandFeishu},
+		{Name: "other", AppId: "cli_other", AppSecret: core.PlainSecret("other"), Brand: core.BrandFeishu},
+	}}
+	if err := core.SaveMultiAppConfig(config); err != nil {
+		t.Fatal(err)
+	}
+	f, _, _, _ := cmdutil.TestFactory(t, nil)
+	if err := authLogoutRun(&LogoutOptions{Factory: f, JSON: true, PurgeLocalProfile: true}); err == nil {
+		t.Fatal("shared config was purged")
+	}
+	if _, err := os.Stat(core.GetConfigPath()); err != nil {
+		t.Fatalf("shared config was changed: %v", err)
+	}
+}
