# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# lark-cli remains the only Feishu API/outbound client. Leave LARK_CLI_BIN unset to use
# the platform default (.bin/lark-cli on macOS; the official run.js entry on Windows).
# LARK_CLI_BIN=
LARK_CLI_PROFILE=default
LARK_CLI_AS=bot
FEISHU_EVENT_CONSUMER_ENABLED=true
FEISHU_EVENT_TRANSPORT=official-sdk
# Runtime profile is stored in the platform private data root. The bridge polls it for UI/CLI changes.
FEISHU_EVENT_PROFILE_POLL_MS=1000
# Frozen lark-cli 1.0.92 non-Approval event registry. Unknown and Approval keys fail closed.
# Card callbacks and the other event types still require enabling/publishing them in the Feishu console.
FEISHU_EVENT_KEYS=application.bot.menu_v6,board.whiteboard.updated_v1,card.action.trigger,im.chat.disbanded_v1,im.chat.member.bot.added_v1,im.chat.member.bot.deleted_v1,im.chat.member.user.added_v1,im.chat.member.user.deleted_v1,im.chat.member.user.withdrawn_v1,im.chat.updated_v1,im.message.message_read_v1,im.message.reaction.created_v1,im.message.reaction.deleted_v1,im.message.receive_v1,minutes.minute.generated_v1,task.task.update_user_access_v2,vc.meeting.participant_meeting_ended_v1,vc.meeting.participant_meeting_joined_v1,vc.meeting.participant_meeting_started_v1,vc.note.generated_v1,vc.recording.recording_ended_v1,vc.recording.recording_started_v1,vc.recording.recording_transcript_generated_v1
FEISHU_EVENT_INBOX_ENABLED=true
# Defaults to the platform private data root.
# FEISHU_EVENT_INBOX_DIR=
# Total temporary attachment bytes accepted from one inbound message.
FEISHU_INBOUND_MAX_BYTES=26214400

# Local project and log paths.
# The launcher resolves its own project root; set only for an external supervisor.
# FEISHU_BRIDGE_PROJECT_ROOT=
# Service identifiers. Keep these aligned with the installed LaunchAgent or Scheduled Task.
FEISHU_BRIDGE_LAUNCHD_LABEL=com.example.feishu-bot-bridge
FEISHU_BRIDGE_WINDOWS_TASK_NAME=FeishuBotBridge
# macOS default: <project>/logs; Windows default: %USERPROFILE%\.config\feishu-bridge\logs
# FEISHU_BRIDGE_DATA_DIR=
# FEISHU_BRIDGE_LOG_DIR=
# Shared queue state retention and file-size warning thresholds.
FEISHU_QUEUE_MAX_PROCESSED_IDS=5000
FEISHU_QUEUE_WARN_BYTES=104857600

# Local audit output.
KMS_ROOT=/path/to/knowledge-workspace
# Optional KSF root used to resolve and verify default-chat project promotion.
# KSF_PROJECT_ROOT=/path/to/KSF
# FEISHU_AUDIT_DIR=

# Codex runtime.
# Defaults to codex on macOS and codex.exe on Windows.
# CODEX_BIN=
CODEX_TRANSPORT=auto
CODEX_AUTO_START_DAEMON=true
# Legacy migration key only. The bridge removes this old global pointer at startup;
# new default conversations are bound one Thread per root Feishu message.
CODEX_FEISHU_DEFAULT_SESSION=feishu-default-kms
CODEX_FEISHU_DEFAULT_THREAD_TITLE=飞书默认对话
CODEX_TIMEOUT_MS=600000
CODEX_TASK_TIMEOUT_MS=1800000
CODEX_BYPASS_APPROVALS=true
CODEX_APP_SERVER_REQUEST_TIMEOUT_MS=60000
# macOS defaults to ~/.codex/ipc/ipc.sock. Windows task-link control is optional and
# requires an explicit private named pipe such as \\.\pipe\codex-desktop-<user>.
# CODEX_DESKTOP_IPC_PATH=
CODEX_DESKTOP_REQUEST_TIMEOUT_MS=20000
CODEX_CLIENT_NAME=codex_vscode
CODEX_CLIENT_TITLE=Codex

# Inbound permissions.
# Direct chat requires explicit open_id allowlist.
FEISHU_DIRECT_ALLOWED_OPEN_IDS=ou_xxx

# Group inbound is disabled by default for safety.
FEISHU_GROUP_ENABLED=false
FEISHU_GROUP_ALLOWED_CHAT_IDS=oc_xxx
FEISHU_GROUP_ALLOWED_OPEN_IDS=ou_xxx

# Outbound outbox.
# Keep dry-run enabled until target handling, logs, audit, and dedupe have been verified.
FEISHU_OUTBOUND_ENABLED=false
# FEISHU_OUTBOX_PATH=
FEISHU_OUTBOX_POLL_MS=3000
FEISHU_OUTBOUND_DRY_RUN=true

# Local wake endpoint. It only wakes the worker; it does not carry message payloads.
FEISHU_OUTBOUND_WAKE_ENABLED=false
FEISHU_OUTBOUND_WAKE_HOST=127.0.0.1
FEISHU_OUTBOUND_WAKE_PORT=0

# Read-only Feishu directory cache used for exact-name resolution before outbox submission.
# Keep disabled until the app has organization-wide contact visibility and read-only scopes.
FEISHU_DIRECTORY_ENABLED=false
# FEISHU_DIRECTORY_CACHE_PATH=
# FEISHU_DIRECTORY_STATE_PATH=
FEISHU_DIRECTORY_REFRESH_MS=21600000
FEISHU_DIRECTORY_MAX_AGE_MS=86400000
FEISHU_DIRECTORY_PAGE_SIZE=50
FEISHU_DIRECTORY_MIN_USER_COUNT=1

# Read-only cache of groups the bot has joined, used for exact group-name resolution.
FEISHU_GROUP_DIRECTORY_ENABLED=false
# FEISHU_GROUP_DIRECTORY_CACHE_PATH=
# FEISHU_GROUP_DIRECTORY_STATE_PATH=
FEISHU_GROUP_DIRECTORY_REFRESH_MS=1800000
FEISHU_GROUP_DIRECTORY_MAX_AGE_MS=7200000
FEISHU_GROUP_DIRECTORY_PAGE_SIZE=100

# Document task docbox.
# Docbox orchestrates Codex/lark-cli document creation and editing. It does not carry Feishu messages.
FEISHU_DOCBOX_ENABLED=false
# FEISHU_DOCBOX_PATH=
FEISHU_DOCBOX_POLL_MS=3000
FEISHU_DOCBOX_DRY_RUN=true
FEISHU_DOCBOX_WAKE_ENABLED=false
FEISHU_DOCBOX_WAKE_HOST=127.0.0.1
FEISHU_DOCBOX_WAKE_PORT=0
FEISHU_DOCBOX_ALLOWED_SOURCES=local,codex

# Exact-registry Feishu action queue. It permits only reviewed registered capabilities.
# The local wake endpoint carries no business payload; polling remains the fallback.
FEISHU_ACTIONBOX_ENABLED=false
# FEISHU_ACTIONBOX_PATH=
FEISHU_ACTIONBOX_POLL_MS=3000
FEISHU_ACTIONBOX_DRY_RUN=true
FEISHU_ACTIONBOX_ALLOWED_SOURCES=local,codex
FEISHU_ACTIONBOX_TIMEOUT_MS=120000
FEISHU_ACTIONBOX_WAKE_ENABLED=false
FEISHU_ACTIONBOX_WAKE_HOST=127.0.0.1
FEISHU_ACTIONBOX_WAKE_PORT=0
