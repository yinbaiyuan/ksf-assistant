{
  "protocol": "codexassistant-feishu-host-task-routing-v1",
  "schemaVersion": 1,
  "hostContext": {
    "protocol": "codexassistant-host-context-v1",
    "schemaVersion": 1,
    "states": ["not_configured", "ready", "invalid"],
    "readyRootField": "ksf.root"
  },
  "rootMessageRouting": {
    "ready": "ksf_root_unassigned_task",
    "not_configured": "managed_generic_workspace",
    "invalid": "fail_closed_without_thread",
    "reply": "stored_thread_and_cwd"
  },
  "taskTitle": {
    "prefix": "飞书 · ",
    "normalization": "NFKC",
    "maximumGraphemes": 64,
    "fallback": "飞书任务"
  },
  "transport": {
    "managedBridgeOwned": "app-server",
    "desktopTaskLink": "desktop-ipc",
    "initializeTimeoutMs": 5000,
    "requestTimeoutMs": 60000,
    "threadNameTimeoutMs": 1000,
    "proxyAttempts": 0,
    "daemonStartAttempts": 0
  },
  "timing": {
    "cardLabels": ["总耗时", "Codex"],
    "stages": [
      "event_arrived",
      "processing_card_completed",
      "transport_ready",
      "turn_started",
      "turn_completed",
      "final_card_completed"
    ]
  }
}
