{
  "schemaVersion": 1,
  "cardRevision": 37,
  "taskHeader": {
    "primaryRow": ["taskTitle", "task_link_release"],
    "secondaryRow": ["context", "duration", "lease"],
    "taskTitleStyle": "strong",
    "metadataStyle": "muted",
    "releaseLabel": "断开"
  },
  "states": {
    "running": {
      "topActions": ["task_link_release"],
      "inputRow": ["task_link_interrupt", "followup", "task_link_followup"],
      "formIntent": null,
      "placeholder": "补充或修正",
      "formFields": ["followup"],
      "submitLabel": "发送"
    },
    "waiting_input": {
      "topActions": ["task_link_release"],
      "inputRow": ["task_link_interrupt", "followup", "task_link_followup"],
      "formIntent": "回答 Codex",
      "formFields": ["followup"],
      "submitLabel": "发送"
    },
    "completed": {
      "topActions": ["task_link_release"],
      "formIntent": "开始新一轮",
      "modePlacement": "adjacent_to_form_intent",
      "formFields": ["turnMode", "followup"],
      "turnModes": ["default", "plan"],
      "submitLabel": "发送"
    },
    "plan_ready": {
      "topActions": ["task_link_release"],
      "primaryAction": "task_link_implement_plan",
      "primaryActionWidth": "content",
      "primaryActionAlignment": "center",
      "oversizePlanDelivery": "threaded_text_parts",
      "formIntent": "修改计划",
      "formFields": ["followup"],
      "submitLabel": "提交修改"
    },
    "queued": {
      "topActions": ["task_link_release"],
      "bodyActions": ["task_link_interrupt"],
      "formIntent": null,
      "formFields": []
    },
    "desktop_action_required": {
      "topActions": ["task_link_release"],
      "bodyActions": ["task_link_interrupt"],
      "formIntent": null,
      "formFields": []
    },
    "ordinary_completed": {
      "topActions": ["dismiss"],
      "formIntent": null,
      "formFields": ["followup"],
      "submitLabel": "发送"
    }
  },
  "callbacks": {
    "task_link_followup": {
      "required": ["taskKey", "followup"],
      "optional": ["intent", "turnMode"],
      "intents": ["new_turn"],
      "turnModes": ["default", "plan"]
    },
    "task_link_implement_plan": {
      "required": ["taskKey", "planRevision"]
    },
    "task_link_release": {
      "transport": "button",
      "label": "断开",
      "style": "danger"
    },
    "task_link_interrupt": {
      "transport": "button",
      "label": "停止",
      "style": "danger"
    },
    "dismiss": {
      "transport": "overflow"
    }
  }
}
