{
  "name": "codexassistant-windows",
  "version": "0.10.0-preview.1",
  "private": true,
  "description": "Windows system-tray host for CodexAssistant",
  "author": "CodexAssistant contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:core": "node scripts/build-core.mjs",
    "prepare:feishu": "node ../scripts/prepare-feishu-runtime.mjs --platform windows --arch x64 --arch arm64",
    "sbom": "node ../scripts/generate-sbom.mjs",
    "pack:win": "npm run build:core && npm run prepare:feishu && npm run sbom && electron-builder --win --dir --x64 && electron-builder --win --dir --arm64",
    "dist:win": "npm run build:core && npm run prepare:feishu && npm run sbom && electron-builder --win nsis --x64 && electron-builder --win nsis --arm64"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.codexassistant.desktop",
    "productName": "CodexAssistant",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/core/windows-${arch}",
        "to": "core/windows-${arch}",
        "filter": ["codex-usage-core.exe"]
      },
      {
        "from": "../dist/services/feishu-bridge",
        "to": "services/feishu-bridge",
        "filter": ["**/*", "!node_modules/**/*"]
      },
      {
        "from": "../dist/services/feishu-bridge/node_modules",
        "to": "services/feishu-bridge/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../dist/runtime/node/windows-${arch}",
        "to": "runtime/node/windows-${arch}",
        "filter": ["node.exe"]
      },
      {
        "from": "../dist/runtime/feishu-bridge/windows-${arch}",
        "to": "runtime/feishu-bridge/windows-${arch}",
        "filter": ["codex-feishu-bridge.exe"]
      },
      {
        "from": "../dist/runtime/lark-cli/windows-${arch}",
        "to": "runtime/lark-cli/windows-${arch}",
        "filter": ["lark-cli.exe"]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../dist/sbom/CodexAssistant.spdx.json",
        "to": "CodexAssistant.spdx.json"
      }
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "target": "nsis",
      "artifactName": "CodexAssistant-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "CodexAssistant",
      "deleteAppDataOnUninstall": false
    }
  }
}
